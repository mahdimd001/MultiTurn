#!/bin/bash

#SBATCH --time=24:00:00   # walltime limit (HH:MM:SS)
#SBATCH --nodes=1   # number of nodes
#SBATCH --ntasks-per-node=1
#SBATCH --mem=100G   # maximum memory per node
#SBATCH --gres=gpu:a100:1
#SBATCH --partition=nova
#SBATCH --job-name="ghostkv"
#SBATCH --error="%j-error"
#SBATCH --output="ghostkv-%j.out"

# GhostKV against PyramidKV, TurnCast-KV and SeedKV on ConvBench and MultiVerse.
#
#   sbatch run-job-ghostkv                                   # calibrate once, then everything
#   sbatch --export=ALL,RATIOS="0.9",STAGES="ppl" run-job-ghostkv
#   sbatch --export=ALL,METHODS="ghostkv",GHOSTKV_ARGS="--ghostkv-no-paging",TAG="-nopaging",STAGES="ppl rouge" run-job-ghostkv
#
# STAGES: any of  calibrate ppl rouge efficiency
# The calibration file is made once per model (STAGES contains "calibrate" and the
# file does not exist yet).  It uses the first CALIB_SAMPLES conversations of
# ConvBench with the full cache; nothing is trained.

source /lustre/hdd/LAS/jannesar-lab/tmahmud/ecache/bin/activate

ROOT=/lustre/hdd/LAS/jannesar-lab/msamani/modality_aware_KVCache
MODEL=${MODEL:-/lustre/hdd/LAS/jannesar-lab/tmahmud/models/llava-v1.5-7b}
RATIOS=${RATIOS:-"0.9 0.8 0.5"}
METHODS=${METHODS:-"pyramidkv turncast_kv seedkv ghostkv"}
STAGES=${STAGES:-"calibrate ppl rouge efficiency"}
SAMPLES_ARG=${SAMPLES:+--eval-samples $SAMPLES}     # default: all conversations
MAXTOK=${MAXTOK:-512}
# Image-first layout (mm_layout.py): a locator file made with the old layout
# (question before the image) is not valid any more, hence the new name.
LOCATORS=${LOCATORS:-$ROOT/ghostkv_data/locators_llava15_7b_imagefirst.pt}
CALIB_SAMPLES=${CALIB_SAMPLES:-20}
# Extra flags for GhostKV only, e.g. "--ghostkv-max-faults 1" (fewer regenerations),
# "--seedkv-allocation pyramidkv" (same entries per layer as PyramidKVCache) or
# "--ghostkv-no-paging" (the ablation).
GHOSTKV_ARGS=${GHOSTKV_ARGS:-}
TAG=${TAG:-}

declare -A DATA IMAGES
DATA[Convbench]=$ROOT/ConvBench/convbench.json
IMAGES[Convbench]=$ROOT/ConvBench/visit_bench_images
DATA[MultiVerse]=$ROOT/MultiVerse_for_ppl/multiverse_ppl_full.json
IMAGES[MultiVerse]=$ROOT/MultiVerse_raw/images

if [[ " $STAGES " == *" calibrate "* && ! -f "$LOCATORS" ]]; then
  mkdir -p "$(dirname "$LOCATORS")"
  python eval_ppl_final.py \
    --model-path $MODEL \
    --data-path ${DATA[Convbench]} --image-path ${IMAGES[Convbench]} \
    --eval-samples $CALIB_SAMPLES \
    --method ghostkv --ratio 0.9 --ghostkv-calibrate $LOCATORS \
    --output-dir logs_ppl_llava/ghostkv --exp-name calibration
fi

for DATASET in Convbench MultiVerse; do
  for RATIO in $RATIOS; do
    for METHOD in $METHODS; do
      NAME=${DATASET}-${RATIO}-${METHOD}
      EXTRA=""
      if [[ "$METHOD" == "ghostkv" ]]; then
        EXTRA="--ghostkv-locators $LOCATORS $GHOSTKV_ARGS"
        NAME=${NAME}${TAG}
      fi

      if [[ " $STAGES " == *" ppl "* ]]; then
        python eval_ppl_final.py \
          --model-path $MODEL \
          --data-path ${DATA[$DATASET]} --image-path ${IMAGES[$DATASET]} \
          $SAMPLES_ARG \
          --method $METHOD --ratio $RATIO $EXTRA \
          --output-dir logs_ppl_llava/ghostkv --exp-name $NAME
      fi

      if [[ " $STAGES " == *" rouge "* ]]; then
        python eval_rouge_final2.py \
          --model-path $MODEL \
          --data-path ${DATA[$DATASET]} --image-path ${IMAGES[$DATASET]} \
          $SAMPLES_ARG --max-token-generated $MAXTOK \
          --method $METHOD --ratio $RATIO $EXTRA \
          --output-dir logs_rouge_llava/ghostkv/$NAME
      fi
    done
  done
done

# Latency, throughput and memory.  GhostKV's regenerations are inside the step
# that faults; it has no transient peak (compare kv_peak with seedkv's).
if [[ " $STAGES " == *" efficiency "* ]]; then
  python eval_efficiency.py \
    --methods full $METHODS \
    --ratios $RATIOS --ghostkv-locators $LOCATORS \
    --context-lengths native 2048 3584 --long-context-mode images \
    --gen-tokens 64 --num-turns 3
fi
