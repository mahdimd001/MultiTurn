+"""Paired comparison of two eval_rouge_final2.py prediction files.
+
+    python compare_rouge_runs.py BASELINE_predictions.json NEW_predictions.json
+
+Both runs must cover the same items in the same order (same --data-path and
+--eval-samples).  Every scored turn is paired with the same turn of the other
+run, so the comparison is per (conversation, turn) and is far more sensitive
+than comparing two averages.
+
+Reports, overall and per turn:
+  mean ROUGE-L F1 of each run, the paired mean difference (new - baseline),
+  a 95% paired bootstrap confidence interval, and win / tie / loss counts.
+A difference whose CI excludes 0 is a reliable improvement or regression.
+"""
+import argparse
+import json
+import random
+
+
+def load_turns(path):
+    data = json.load(open(path))
+    rows = {}
+    for item_index, item in enumerate(data["results"]):
+        for turn in item["turns"]:
+            rows[(item_index, int(turn["turn"]))] = float(turn["rouge_l_f"])
+    return data, rows
+
+
+def bootstrap_ci(diffs, rounds, seed):
+    rng = random.Random(seed)
+    n = len(diffs)
+    means = []
+    for _ in range(rounds):
+        sample = [diffs[rng.randrange(n)] for _ in range(n)]
+        means.append(sum(sample) / n)
+    means.sort()
+    return means[int(0.025 * rounds)], means[int(0.975 * rounds) - 1]
+
+
+def summarize(name, base, new, rounds, seed):
+    diffs = [b - a for a, b in zip(base, new)]
+    n = len(diffs)
+    lo, hi = bootstrap_ci(diffs, rounds, seed)
+    wins = sum(d > 1e-9 for d in diffs)
+    losses = sum(d < -1e-9 for d in diffs)
+    verdict = "better" if lo > 0 else "worse" if hi < 0 else "n.s."
+    print(f"{name:<8} n={n:<5} base={sum(base)/n:.4f} new={sum(new)/n:.4f} "
+          f"diff={sum(diffs)/n:+.4f}  95%CI=[{lo:+.4f},{hi:+.4f}]  "
+          f"W/T/L={wins}/{n - wins - losses}/{losses}  {verdict}")
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("baseline")
+    parser.add_argument("new")
+    parser.add_argument("--rounds", type=int, default=5000)
+    parser.add_argument("--seed", type=int, default=0)
+    args = parser.parse_args()
+
+    base_data, base = load_turns(args.baseline)
+    new_data, new = load_turns(args.new)
+    keys = sorted(set(base) & set(new))
+    if len(keys) != len(base) or len(keys) != len(new):
+        print(f"[warning] only {len(keys)} turns are present in both runs "
+              f"(baseline {len(base)}, new {len(new)}).")
+    for data in (base_data, new_data):
+        print(f"{data['experiment']}: method={data['method']} ratio={data['ratio']} "
+              f"items={data['evaluated_items']} avg={data['avg_rouge_l_f']:.4f}")
+    summarize("all", [base[k] for k in keys], [new[k] for k in keys], args.rounds, args.seed)
+    for turn in sorted({k[1] for k in keys}):
+        sub = [k for k in keys if k[1] == turn]
+        summarize(f"turn {turn}", [base[k] for k in sub], [new[k] for k in sub],
+                  args.rounds, args.seed)
+
+
+if __name__ == "__main__":
+    main()
