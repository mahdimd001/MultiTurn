new file mode 100644
index 0000000..28b8247
--- /dev/null
+++ b/rehearsal_toy/score_toy.py
@@ -0,0 +1,54 @@
+"""Score MT-Blocks runs: exact answer accuracy per turn and per question type.
+
+A turn is correct when the LAST color word in the prediction is the target
+color (answers have the form "The color ... is <color>.").
+Usage: python score_toy.py test.json run1_predictions.json [run2 ...]
+"""
+import json
+import re
+import sys
+
+COLORS = ["red", "green", "blue", "yellow", "purple", "orange", "pink", "cyan", "white", "brown"]
+PATTERN = re.compile(r"\b(" + "|".join(COLORS) + r")\b")
+
+
+def turn_kinds(item):
+    """Label turns: t1, follow (same object as T1), new (unseen object), revisit."""
+    seen, kinds = [], []
+    for index, turn in enumerate(item["turns"]):
+        key = re.search(r"the (\w+) block", turn["question"]).group(1)
+        if index == 0:
+            kinds.append("t1")
+        elif key in seen:
+            kinds.append("follow" if index == 1 else "revisit")
+        else:
+            kinds.append("new")
+        seen.append(key)
+    return kinds
+
+
+def score(test, run):
+    stats = {}
+    for item, result in zip(test, run["results"]):
+        assert item["image"] == result["image"]
+        for kind, turn, pred in zip(turn_kinds(item), item["turns"], result["turns"]):
+            colors = PATTERN.findall(pred["prediction"].lower())
+            ok = bool(colors) and colors[-1] == turn["target"]
+            for key in (f"turn{pred['turn']}", kind, "all"):
+                hit, total = stats.get(key, (0, 0))
+                stats[key] = (hit + ok, total + 1)
+    return stats
+
+
+if __name__ == "__main__":
+    test = json.load(open(sys.argv[1]))
+    keys = ["all", "turn1", "turn2", "turn3", "follow", "new", "revisit"]
+    print(f"{'run':<44}" + "".join(f"{k:>9}" for k in keys))
+    for path in sys.argv[2:]:
+        run = json.load(open(path))
+        stats = score(test, run)
+        cells = []
+        for key in keys:
+            hit, total = stats.get(key, (0, 0))
+            cells.append(f"{100.0 * hit / total:8.1f}%" if total else "      n/a")
+        print(f"{run['experiment'][:43]:<44}" + "".join(cells))
diff --git a/rehearsal_toy/test_rehearsal.py b/rehearsal_toy/test_rehearsal.py
new file mode 100644
index 0000000..2c3631a
--- /dev/null
+++ b/rehearsal_toy/test_rehearsal.py
@@ -0,0 +1,95 @@
+"""Correctness tests for RehearsalKVCache on any LLaVA checkpoint (TOY_MODEL=<path>, TEST_DEVICE=cuda|cpu)."""
+import os
+import sys
+
+import torch
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, REPO)
+os.chdir(REPO)
+torch.manual_seed(0)
+torch.set_num_threads(1)
+
+from kv_cache_rehearsal import RehearsalKVCache  # noqa: E402
+from llava.model.builder import load_pretrained_model  # noqa: E402
+from tgv_kv_legacy_nova import enable_legacy_tgv_attention, enable_online_attention  # noqa: E402
+
+enable_legacy_tgv_attention()
+path = os.environ.get("TOY_MODEL", os.path.join(REPO, "rehearsal_toy", "work", "models_needles", "llava-v1.5-7b-needles"))
+DEVICE = os.environ.get("TEST_DEVICE", "cuda" if torch.cuda.is_available() else "cpu")
+tok, model, _, _ = load_pretrained_model(path, None, os.path.basename(path.rstrip("/")) or "llava", device=DEVICE)
+model = (model.float() if DEVICE == "cpu" else model).eval()   # CPU has no fp16/bf16 GEMM in torch 2.1
+enable_online_attention(model)
+L = model.config.num_hidden_layers
+
+# A fake "conversation" cache: prefill 120 text tokens.
+ids = torch.randint(5, len(tok) - 1, (1, 120), device=DEVICE)
+with torch.no_grad():
+    out = model(input_ids=ids, use_cache=True)
+past = [[k, v] for k, v in out.past_key_values]
+
+cache = RehearsalKVCache(layer_num=L, ratio=0.8, tokenizer=tok)
+cache.attach_model(model)
+cache.register_question("What color is the car?")
+
+# 1) The rehearsal leaves the cache and the next-token prediction untouched.
+before = [(k.clone(), v.clone()) for k, v in past]
+nxt = torch.tensor([[7]], device=DEVICE)
+with torch.no_grad():
+    ref = model(input_ids=nxt, position_ids=torch.tensor([[120]], device=DEVICE),
+                past_key_values=past, use_cache=True).logits
+cache.latest_logical_len = 120
+cache._rehearse(past, "prefill")
+same = all(torch.equal(k, a) and torch.equal(v, b) for (k, v), (a, b) in zip(past, before))
+with torch.no_grad():
+    after = model(input_ids=nxt, position_ids=torch.tensor([[120]], device=DEVICE),
+                  past_key_values=past, use_cache=True).logits
+print("1) cache unchanged by rehearsal:", same, "| next-token logits identical:",
+      torch.equal(ref, after))
+assert same and torch.equal(ref, after)
+
+# 2) Exact budget, also when layers have uneven lengths (as after a prior compression).
+cache = RehearsalKVCache(layer_num=L, ratio=0.8, tokenizer=tok)
+cache.attach_model(model)
+cache.register_question("What color is the car?")
+new = cache(past, num_of_token=120)                       # prefill compression
+target = int(120 * (1.0 - 0.8))
+lengths = [k.shape[2] for k, _ in new]
+print("2a) prefill: target/layer", target, "mean kept", sum(lengths) / L, "min/max", min(lengths), max(lengths))
+assert sum(lengths) == target * L
+# Grow every layer by 30 "answer" tokens, then compress at a turn boundary.
+grown = []
+from tgv_kv_legacy_nova import set_legacy_logical_position_limit  # noqa: E402
+set_legacy_logical_position_limit(model, 150)   # the evaluator does this before every forward
+with torch.no_grad():
+    o = model(input_ids=torch.randint(5, len(tok) - 1, (1, 30), device=DEVICE),
+              position_ids=torch.arange(120, 150, device=DEVICE).unsqueeze(0),
+              past_key_values=new, use_cache=True)
+grown = [[k, v] for k, v in o.past_key_values]
+cache.latest_logical_len = 150
+final = cache.finalize_turn(grown)
+lengths = [k.shape[2] for k, _ in final]
+print("2b) boundary: target/layer", int(150 * (1.0 - 0.8)), "mean kept", sum(lengths) / L,
+      "stats acts", cache.last_finalize_stats["rehearsal_acts"])
+assert sum(lengths) == int(150 * (1.0 - 0.8)) * L
+
+# 3) Sink and the 8 most recent entries are always kept (check via key identity, head 0).
+k_before = grown[5][0][0, 0]          # [S, D] layer 5 head 0 before compression
+k_after = final[5][0][0, 0]
+def contains(row):
+    return bool(((k_after - row).abs().sum(-1) == 0).any())
+ok_sink = contains(k_before[0])
+ok_recent = all(contains(k_before[-i]) for i in range(1, 9))
+print("3) sink kept:", ok_sink, "| 8 recent kept:", ok_recent)
+assert ok_sink and ok_recent
+
+# 4) GQA path: 8 query heads sharing 2 KV heads.
+gqa = RehearsalKVCache(layer_num=1, ratio=0.5, tokenizer=tok)
+gqa._kv_lengths, gqa._kv_heads = [20], [2]
+gqa._scores, gqa._demand = [None], [None]
+gqa._weights = torch.full((4,), 0.25)
+att = torch.softmax(torch.randn(1, 8, 4, 24), dim=-1)
+gqa._rehearsal_sink(0, att)
+print("4) GQA scores shape:", tuple(gqa._scores[0].shape), "demand:", round(float(gqa._demand[0]), 4))
+assert gqa._scores[0].shape == (2, 20)
+print("ALL TESTS PASSED")
diff --git a/rehearsal_toy/train_toy.py b/rehearsal_toy/train_toy.py
new file mode 100644
index 0000000..880b71b
--- /dev/null
+++ b/rehearsal_toy/train_toy.py
@@ -0,0 +1,240 @@
+"""Train a tiny LLaVA-architecture model on MT-Blocks (CPU, from scratch).
+
+Uses the repo's own LlavaLlamaForCausalLM, the LLaVA v1 conversation template
+and the evaluator's prompt format ("Q1\\n<image>"), so the trained checkpoint
+loads with llava.model.builder.load_pretrained_model and runs unchanged
+through eval_rouge_final2.py.  Loss is on assistant answers only (LLaVA SFT).
+"""
+import json
+import math
+import os
+import random
+import sys
+import time
+
+import numpy as np
+import sentencepiece as spm
+import torch
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.dirname(HERE)
+sys.path.insert(0, REPO)
+sys.path.insert(0, HERE)
+torch.set_num_threads(2)
+
+TASK = os.environ.get("TOY_TASK", "blocks")
+if TASK == "needles":
+    from make_needles import conversation, draw, sample_scene, train_conversation  # noqa: E402
+else:
+    from make_mtblocks import conversation, draw, sample_scene  # noqa: E402
+
+OUT = os.environ.get("TOY_MODELS", os.path.join(HERE, "work", "models_" + TASK))
+LLM_DIR = os.path.join(OUT, "llava-v1.5-7b-mtblocks" if TASK == "blocks" else "llava-v1.5-7b-needles")   # "llava", "v1", "7b" drive the evaluator
+CLIP_DIR = os.path.join(OUT, "clip-mtblocks-168")
+STEPS = int(os.environ.get("STEPS", 3000))
+BATCH = int(os.environ.get("BATCH", 8))
+LAYERS = int(os.environ.get("LAYERS", 8))
+os.makedirs(LLM_DIR, exist_ok=True)
+os.makedirs(CLIP_DIR, exist_ok=True)
+torch.manual_seed(0)
+random.seed(0)
+
+SYSTEM = ("A chat between a curious human and an artificial intelligence assistant. "
+          "The assistant gives helpful, detailed, and polite answers to the human's questions.")
+
+# ---------------------------------------------------------------- tokenizer
+RESUME = os.environ.get("RESUME")      # continue from a saved checkpoint dir
+if RESUME:
+    import shutil
+    for name in ("tokenizer.model", "tokenizer_config.json", "special_tokens_map.json"):
+        shutil.copy(os.path.join(RESUME, name), os.path.join(LLM_DIR, name))
+    from transformers import CLIPImageProcessor, CLIPVisionConfig, CLIPVisionModel  # noqa: E402
+else:
+    corpus = os.path.join(OUT, "corpus.txt")
+    rng = random.Random(123)
+    with open(corpus, "w") as handle:
+        for _ in range(4000):
+            objs = sample_scene(rng)
+            for q, a, _ in conversation(objs, rng, True):
+                handle.write(q + "\n" + a + "\n")
+        # Tokenizer corpus only (no model training on these): frequent enough that
+        # template words become single pieces instead of byte fallbacks.
+        for _ in range(1500):
+            handle.write(SYSTEM + "\nUSER: ASSISTANT:\nSummarize our conversation so far.\n")
+    spm.SentencePieceTrainer.train(
+        input=corpus, model_prefix=os.path.join(OUT, "tok"), vocab_size=600, model_type="bpe",
+        byte_fallback=True, character_coverage=1.0, unk_id=0, bos_id=1, eos_id=2, pad_id=-1,
+        num_threads=2, minloglevel=2,
+    )
+    from transformers import (  # noqa: E402
+        CLIPImageProcessor, CLIPVisionConfig, CLIPVisionModel, LlamaForCausalLM, LlamaTokenizer,
+    )
+
+    LlamaTokenizer(vocab_file=os.path.join(OUT, "tok.model"), legacy=True).save_pretrained(LLM_DIR)
+# Reload exactly as the evaluator does (load_pretrained_model -> AutoTokenizer,
+# use_fast=False): only then is "</s>" an unsplittable EOS token.
+from transformers import AutoTokenizer  # noqa: E402
+
+tok = AutoTokenizer.from_pretrained(LLM_DIR, use_fast=False)
+assert tok("a</s>USER:", add_special_tokens=False).input_ids.count(tok.eos_token_id) == 1, \
+    "'</s>' must encode as the EOS id, as in the evaluator"
+
+from llava.constants import IGNORE_INDEX, IMAGE_TOKEN_INDEX  # noqa: E402
+from llava.conversation import conv_templates  # noqa: E402
+from llava.mm_utils import tokenizer_image_token  # noqa: E402
+from llava.model.language_model.llava_llama import LlavaConfig, LlavaLlamaForCausalLM  # noqa: E402
+
+# ---------------------------------------------------------------- models
+clip_cfg = CLIPVisionConfig(hidden_size=64, intermediate_size=128, num_hidden_layers=2,
+                            num_attention_heads=4, image_size=168, patch_size=14, projection_dim=64)
+clip = (CLIPVisionModel.from_pretrained(os.environ["RESUME_CLIP"]) if RESUME
+        else CLIPVisionModel(clip_cfg))
+# VISION=analytic (default for the needles task): a FROZEN tower whose patch
+# features are the mean colours of the patch's top half and two bottom stripes
+# (identity encoder layers) - like LLaVA, which keeps CLIP frozen and trains
+# only the projector and the LLM.  VISION=learned trains the tower from pixels.
+VISION = os.environ.get("VISION", "analytic" if TASK == "needles" else "learned")
+if VISION == "analytic" and not RESUME:
+    vm = clip.vision_model
+    with torch.no_grad():
+        w = torch.zeros_like(vm.embeddings.patch_embedding.weight)    # [64, 3, 14, 14]
+        for c in range(3):
+            w[c, c, 0:7, :] = 1.0 / (7 * 14)        # top half: key colour
+            w[3 + c, c, 7:14, 0:7] = 1.0 / 49       # bottom-left stripe
+            w[6 + c, c, 7:14, 7:14] = 1.0 / 49      # bottom-right stripe
+        vm.embeddings.patch_embedding.weight.copy_(w)
+        vm.embeddings.position_embedding.weight.zero_()
+        vm.embeddings.class_embedding.zero_()
+        for layer in vm.encoder.layers:              # identity encoder layers
+            layer.self_attn.out_proj.weight.zero_()
+            layer.self_attn.out_proj.bias.zero_()
+            layer.mlp.fc2.weight.zero_()
+            layer.mlp.fc2.bias.zero_()
+if VISION == "analytic":
+    clip.requires_grad_(False)
+clip.save_pretrained(CLIP_DIR)   # LlavaMetaModel reads this config at construction
+processor = CLIPImageProcessor(size={"shortest_edge": 168}, crop_size={"height": 168, "width": 168},
+                               image_mean=[0.48145466, 0.4578275, 0.40821073],
+                               image_std=[0.26862954, 0.26130258, 0.27577711])
+processor.save_pretrained(CLIP_DIR)
+
+cfg = LlavaConfig(vocab_size=len(tok), hidden_size=128, intermediate_size=352,
+                  num_hidden_layers=LAYERS, num_attention_heads=4, num_key_value_heads=4,
+                  max_position_embeddings=2048, rms_norm_eps=1e-5, bos_token_id=1,
+                  eos_token_id=2, pad_token_id=0, tie_word_embeddings=False)
+cfg.mm_vision_tower = CLIP_DIR
+cfg.mm_hidden_size = 64
+cfg.mm_projector_type = "mlp2x_gelu"
+cfg.mm_vision_select_layer = -2
+cfg.mm_vision_select_feature = "patch"
+cfg.mm_use_im_start_end = False
+cfg.mm_use_im_patch_token = False
+cfg.image_aspect_ratio = "pad"
+cfg.use_mm_proj = True
+model = LlavaLlamaForCausalLM(cfg)
+if RESUME:
+    state = torch.load(os.path.join(RESUME, "pytorch_model.bin"), map_location="cpu")
+    print("resume:", model.load_state_dict(state, strict=False))
+projector = model.get_model().mm_projector
+embed = model.get_model().embed_tokens
+
+
+def encode(image_batch):
+    feats = clip(image_batch, output_hidden_states=True).hidden_states[-2][:, 1:]
+    return projector(feats)
+
+
+def render_example(rng, nrng):
+    objs = sample_scene(rng)
+    turns = train_conversation(objs, rng) if TASK == "needles" else conversation(objs, rng, True)
+    conv = conv_templates["llava_v1"].copy()
+    ids, labels, prev = None, None, []
+    for index, (q, a, _) in enumerate(turns):
+        if index == 0:
+            q = q + "\n<image>"
+        conv.append_message(conv.roles[0], q)
+        conv.append_message(conv.roles[1], None)
+        before = tokenizer_image_token(conv.get_prompt(), tok, IMAGE_TOKEN_INDEX)
+        conv.messages[-1][-1] = a
+        after = tokenizer_image_token(conv.get_prompt(), tok, IMAGE_TOKEN_INDEX)
+        assert after[:len(before)] == before, "template not prefix-stable"
+        assert before[:len(prev)] == prev, "turn not prefix-stable"
+        prev = after
+    ids = prev
+    # Labels: assistant answers + "</s>" only.
+    labels = [IGNORE_INDEX] * len(ids)
+    conv2 = conv_templates["llava_v1"].copy()
+    for index, (q, a, _) in enumerate(turns):
+        if index == 0:
+            q = q + "\n<image>"
+        conv2.append_message(conv2.roles[0], q)
+        conv2.append_message(conv2.roles[1], None)
+        start = len(tokenizer_image_token(conv2.get_prompt(), tok, IMAGE_TOKEN_INDEX))
+        conv2.messages[-1][-1] = a
+        end = len(tokenizer_image_token(conv2.get_prompt(), tok, IMAGE_TOKEN_INDEX))
+        for pos in range(start, end):
+            labels[pos] = ids[pos]
+    image = draw(objs, nrng)
+    pixel = processor.preprocess(image, return_tensors="pt")["pixel_values"][0]
+    return ids, labels, pixel
+
+
+def collate(examples):
+    pixels = torch.stack([e[2] for e in examples])
+    vis = encode(pixels)                                   # [B, 144, H]
+    seqs, labs = [], []
+    for b, (ids, labels, _) in enumerate(examples):
+        cut = ids.index(IMAGE_TOKEN_INDEX)
+        pre, post = torch.tensor(ids[:cut]), torch.tensor(ids[cut + 1:])
+        seqs.append(torch.cat([embed(pre), vis[b], embed(post)]))
+        labs.append(torch.tensor(labels[:cut] + [IGNORE_INDEX] * vis.shape[1] + labels[cut + 1:]))
+    length = max(s.shape[0] for s in seqs)
+    emb = torch.zeros(len(seqs), length, seqs[0].shape[-1])
+    lab = torch.full((len(seqs), length), IGNORE_INDEX)
+    mask = torch.zeros(len(seqs), length, dtype=torch.long)
+    for b, (s, l) in enumerate(zip(seqs, labs)):
+        emb[b, :s.shape[0]] = s
+        lab[b, :s.shape[0]] = l
+        mask[b, :s.shape[0]] = 1
+    return emb, lab, mask
+
+
+params = list(model.parameters()) + ([] if VISION == "analytic" else list(clip.parameters()))
+opt = torch.optim.AdamW(params, lr=1e-3, weight_decay=0.0, betas=(0.9, 0.98))
+warm = 0 if RESUME else 150
+CONST_LR = os.environ.get("CONST_LR")   # e.g. 5e-4: no cosine decay
+
+
+def lr_at(step):
+    if step < warm:
+        return (step + 1) / warm
+    return 0.5 * (1 + math.cos(math.pi * (step - warm) / max(1, STEPS - warm)))
+
+
+SEED = int(os.environ.get("SEED", 7))   # use a new seed when resuming
+rng, nrng = random.Random(SEED), np.random.default_rng(SEED)
+model.train()
+clip.train(VISION != "analytic")
+t0, running = time.time(), None
+for step in range(STEPS):
+    for group in opt.param_groups:
+        group["lr"] = float(CONST_LR) if CONST_LR else 1e-3 * lr_at(step)
+    emb, lab, mask = collate([render_example(rng, nrng) for _ in range(BATCH)])
+    # LLaVA's wrapper drops inputs_embeds when images=None, so run the decoder
+    # and LM head directly (same computation as the LLaVA forward with labels).
+    hidden = model.get_model()(inputs_embeds=emb, attention_mask=mask, use_cache=False)[0]
+    logits = model.lm_head(hidden)
+    loss = torch.nn.functional.cross_entropy(
+        logits[:, :-1].reshape(-1, logits.shape[-1]), lab[:, 1:].reshape(-1),
+        ignore_index=IGNORE_INDEX)
+    opt.zero_grad(set_to_none=True)
+    loss.backward()
+    torch.nn.utils.clip_grad_norm_(params, 1.0)
+    opt.step()
+    running = loss.item() if running is None else 0.98 * running + 0.02 * loss.item()
+    if step % 50 == 0 or step == STEPS - 1:
+        print(f"step {step} loss {running:.4f} elapsed {time.time() - t0:.0f}s", flush=True)
+    if (step + 1) % 500 == 0 or step == STEPS - 1:
+        model.save_pretrained(LLM_DIR, safe_serialization=False)
+        clip.save_pretrained(CLIP_DIR)
+print("done")
diff --git a/run-job-rehearsal b/run-job-rehearsal
new file mode 100644
index 0000000..d5257b3
--- /dev/null
+++ b/run-job-rehearsal
@@ -0,0 +1,75 @@
+#!/bin/bash
+
+#SBATCH --time=48:00:00
+#SBATCH --nodes=1
+#SBATCH --ntasks-per-node=1
+#SBATCH --mem=100G
+#SBATCH --gres=gpu:a100:1
+#SBATCH --partition=nova
+#SBATCH --job-name="rehearsal-kv"
+#SBATCH --error="%j-error"
+#SBATCH --output="%j-rehearsal.out"
+
+# RehearsalKV vs PyramidKV on ConvBench and MultiVerse (LLaVA-1.5-7B).
+# Same evaluator and generation settings as the existing logs, so every new
+# run is compared turn-by-turn against the logged PyramidKV run.
+
+source /lustre/hdd/LAS/jannesar-lab/tmahmud/ecache/bin/activate
+shopt -s nocaseglob   # existing logs use both "MultiVerse-" and "Multiverse-"
+
+MODEL=/lustre/hdd/LAS/jannesar-lab/tmahmud/models/llava-v1.5-7b
+ROOT=/lustre/hdd/LAS/jannesar-lab/msamani/modality_aware_KVCache
+CONV_DATA=$ROOT/ConvBench/convbench.json
+CONV_IMG=$ROOT/ConvBench/visit_bench_images
+MV3_DATA=$ROOT/MultiVerse_for_ppl/multiverse_ppl.json        # 3 turns (matches existing logs)
+MV4_DATA=$ROOT/MultiVerse_for_ppl/multiverse_ppl_full.json   # up to 4 turns
+MV_IMG=$ROOT/MultiVerse_raw/images
+
+run () {  # run <tag> <data> <images> <method> <ratio> [extra args...]
+  local TAG=$1 DATA=$2 IMG=$3 METHOD=$4 RATIO=$5; shift 5
+  python eval_rouge_final2.py --model-path $MODEL --data-path $DATA --image-path $IMG \
+      --method $METHOD --ratio $RATIO --output-dir logs_rouge_llava/${TAG}-${RATIO}-${METHOD} "$@"
+}
+
+compare () {  # compare <tag> <ratio>
+  local BASE NEW
+  BASE=$(ls logs_rouge_llava/${1}-${2}-pyramidkv/pyramidkv_ratio${2}_predictions.json 2>/dev/null | head -1)
+  NEW=logs_rouge_llava/${1}-${2}-rehearsal_kv/rehearsal_kv_ratio${2}_predictions.json
+  [ -n "$BASE" ] && [ -f "$NEW" ] && python compare_rouge_runs.py $BASE $NEW \
+      | tee logs_rouge_llava/${1}-${2}-rehearsal_kv/vs_pyramidkv.txt
+}
+
+# 1) Main comparison against the existing PyramidKV logs (ConvBench, MultiVerse 3-turn).
+for RATIO in 0.9 0.8 0.5; do
+  run Convbench  $CONV_DATA $CONV_IMG rehearsal_kv $RATIO; compare Convbench  $RATIO
+  run MultiVerse $MV3_DATA  $MV_IMG   rehearsal_kv $RATIO; compare MultiVerse $RATIO
+done
+
+# 2) 4-turn MultiVerse: no PyramidKV log exists for it yet, so run both.
+for RATIO in 0.9 0.8; do
+  run MultiVerse4 $MV4_DATA $MV_IMG pyramidkv    $RATIO
+  run MultiVerse4 $MV4_DATA $MV_IMG rehearsal_kv $RATIO
+  compare MultiVerse4 $RATIO
+done
+
+# 3) Equal-memory PyramidKV (same pyramid, total exactly L*C) for a fair comparison.
+for RATIO in 0.9 0.8; do
+  run Convbench-exact  $CONV_DATA $CONV_IMG pyramidkv $RATIO --pyramid-exact-budget
+  run MultiVerse-exact $MV3_DATA  $MV_IMG   pyramidkv $RATIO --pyramid-exact-budget
+  for DS in Convbench MultiVerse; do
+    python compare_rouge_runs.py \
+        logs_rouge_llava/${DS}-exact-${RATIO}-pyramidkv/pyramidkv_ratio${RATIO}_exact_predictions.json \
+        logs_rouge_llava/${DS}-${RATIO}-rehearsal_kv/rehearsal_kv_ratio${RATIO}_predictions.json \
+        | tee logs_rouge_llava/${DS}-${RATIO}-rehearsal_kv/vs_pyramidkv_exact.txt
+  done
+done
+
+# 4) Ablations at ratio 0.9: drop one rehearsal act at a time; uniform layer budgets.
+for ACTS in "recall,explore,respond" "revisit,explore,respond" "revisit,recall,respond" "revisit,recall,explore"; do
+  run Convbench-ablation  $CONV_DATA $CONV_IMG rehearsal_kv 0.9 --rehearsal-acts "$ACTS"
+  run MultiVerse-ablation $MV3_DATA  $MV_IMG   rehearsal_kv 0.9 --rehearsal-acts "$ACTS"
+done
+run Convbench-ablation  $CONV_DATA $CONV_IMG rehearsal_kv 0.9 --rehearsal-allocation uniform
+run MultiVerse-ablation $MV3_DATA  $MV_IMG   rehearsal_kv 0.9 --rehearsal-allocation uniform
+run Convbench-ablation  $CONV_DATA $CONV_IMG rehearsal_kv 0.9 --rehearsal-aggregation max
+run MultiVerse-ablation $MV3_DATA  $MV_IMG   rehearsal_kv 0.9 --rehearsal-aggregation max
