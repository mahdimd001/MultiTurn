@@ -0,0 +1,126 @@
+"""MT-Needles: MT-Blocks variant where every object is ONE visual token.
+
+Each object is a single 14-px patch: the top half is its KEY colour, the
+bottom-left quarter its LEFT stripe, the bottom-right quarter its RIGHT
+stripe.  Six objects sit on a noisy gray 12x12 grid (144 visual tokens), so
+every question needs exactly one visual token: evict it and the answer is lost.
+
+Questions:  "What color is the left stripe of the red block?"
+            "What color is the right stripe of the red block?"
+Training only: "Describe the image in detail." (lists every block).
+Test conversations (3 turns): T1 = one stripe of k1; T2 = the other stripe of
+k1 (follow-up, 50%) or a new block (50%); T3 = a new block (50%) or a revisit.
+Same API as make_mtblocks.py (sample_scene, draw, conversation, build).
+"""
+import json
+import os
+import random
+import sys
+
+import numpy as np
+from PIL import Image
+
+PALETTE = {
+    "red": (220, 30, 30), "green": (30, 180, 60), "blue": (40, 70, 230),
+    "yellow": (240, 220, 40), "purple": (150, 50, 190), "orange": (250, 140, 20),
+    "pink": (250, 120, 190), "cyan": (40, 220, 230), "white": (245, 245, 245),
+    "brown": (130, 80, 40),
+}
+GRID, PATCH, N_OBJ = 12, 14, 6
+
+
+def draw(objects, rng):
+    img = rng.normal(90, 10, size=(GRID * PATCH, GRID * PATCH, 3))
+    half = PATCH // 2
+    for obj in objects:
+        r, c = obj["pos"]
+        y, x = r * PATCH, c * PATCH
+        img[y:y + half, x:x + PATCH] = PALETTE[obj["key"]]
+        img[y + half:y + PATCH, x:x + half] = PALETTE[obj["left"]]
+        img[y + half:y + PATCH, x + half:x + PATCH] = PALETTE[obj["right"]]
+    return Image.fromarray(np.clip(img, 0, 255).astype(np.uint8))
+
+
+def sample_scene(rng):
+    colors = list(PALETTE)
+    rng.shuffle(colors)
+    keys, attrs = colors[:N_OBJ], colors[N_OBJ:]
+    cells = rng.sample([(r, c) for r in range(GRID) for c in range(GRID)], N_OBJ)
+    return [{"key": k, "pos": cell, "left": rng.choice(attrs), "right": rng.choice(attrs)}
+            for k, cell in zip(keys, cells)]
+
+
+def qa(obj, side):
+    return (f"What color is the {side} stripe of the {obj['key']} block?",
+            f"The {side} stripe of the {obj['key']} block is {obj[side]}.",
+            obj[side])
+
+
+def describe(objects):
+    ordered = sorted(objects, key=lambda o: o["pos"])
+    parts = [f"the {o['key']} block has a {o['left']} left stripe and a {o['right']} right stripe"
+             for o in ordered]
+    return "Describe the image in detail.", "There are six blocks: " + "; ".join(parts) + ".", None
+
+
+def conversation(objects, rng, allow_describe):
+    other = {"left": "right", "right": "left"}
+    order = list(range(len(objects)))
+    rng.shuffle(order)
+    turns, asked = [], []
+    if allow_describe and rng.random() < 0.15:
+        turns.append(describe(objects))
+    side1 = rng.choice(["left", "right"])
+    turns.append(qa(objects[order[0]], side1))
+    asked.append(order[0])
+    if rng.random() < 0.5:
+        turns.append(qa(objects[order[0]], other[side1]))
+        nxt = 1
+    else:
+        turns.append(qa(objects[order[1]], rng.choice(["left", "right"])))
+        asked.append(order[1])
+        nxt = 2
+    if rng.random() < 0.5:
+        turns.append(qa(objects[order[nxt]], rng.choice(["left", "right"])))
+    else:
+        turns.append(qa(objects[rng.choice(asked)], rng.choice(["left", "right"])))
+    return turns
+
+
+def train_conversation(objects, rng, n_questions=4):
+    """Training only: optional DESCRIBE, then n questions mixing follow-ups,
+    revisits and new blocks (more supervision per image than a test turn)."""
+    turns = [describe(objects)] if rng.random() < 0.15 else []
+    asked = []
+    for _ in range(n_questions):
+        if asked and rng.random() < 0.5:
+            obj = rng.choice(asked)
+        else:
+            obj = rng.choice(objects)
+            asked.append(obj)
+        turns.append(qa(obj, rng.choice(["left", "right"])))
+    return turns
+
+
+def build(out_dir, n, seed, allow_describe):
+    rng = random.Random(seed)
+    nrng = np.random.default_rng(seed)
+    os.makedirs(os.path.join(out_dir, "images"), exist_ok=True)
+    items = []
+    for index in range(n):
+        objects = sample_scene(rng)
+        name = f"ndl_{seed}_{index:06d}.png"
+        draw(objects, nrng).save(os.path.join(out_dir, "images", name))
+        items.append({"image": name,
+                      "turns": [{"question": q, "answer": a, "target": t}
+                                for q, a, t in conversation(objects, rng, allow_describe)],
+                      "objects": objects})
+    return items
+
+
+if __name__ == "__main__":
+    out = sys.argv[1] if len(sys.argv) > 1 else os.path.join(
+        os.path.dirname(os.path.abspath(__file__)), "work", "needles")
+    test = build(out, int(sys.argv[2]) if len(sys.argv) > 2 else 300, 2, False)
+    json.dump(test, open(os.path.join(out, "test.json"), "w"))
+    print("test conversations:", len(test))
