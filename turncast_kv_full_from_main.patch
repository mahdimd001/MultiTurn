index 0000000..2987d6c
--- /dev/null
+++ b/rehearsal_toy/make_mtblocks.py
@@ -0,0 +1,136 @@
+"""MT-Blocks: a synthetic multi-turn visual QA set for KV-eviction mechanism tests.
+
+Each image is a 12x12 grid of 14-px patches (168x168 px -> 144 visual tokens).
+Four "objects" are placed on a noisy gray background.  An object is three
+patches:  a KEY patch, a patch to its RIGHT, and a patch BELOW it.  Key colors
+are unique per image and disjoint from attribute colors, so "the red block"
+names exactly one key patch.
+
+Questions are about one object at a time:
+    RIGHT(k): "What color is to the right of the red block?"
+    BELOW(k): "What color is below the red block?"
+and, in training only, DESCRIBE: "Describe the image in detail." (lists all
+objects) - the analogue of LLaVA's detailed-description instruction data.
+
+A test conversation has three turns:
+    T1  one relation of object k1
+    T2  50% follow-up on k1 (other relation), 50% a NEW object k2
+    T3  50% a NEW object, 50% revisit an object already asked about
+
+So half of the later questions need image regions that Turn 1 never looked
+at - the situation a multi-turn KV cache must anticipate.
+"""
+import json
+import os
+import random
+import sys
+
+import numpy as np
+from PIL import Image
+
+PALETTE = {
+    "red": (220, 30, 30), "green": (30, 180, 60), "blue": (40, 70, 230),
+    "yellow": (240, 220, 40), "purple": (150, 50, 190), "orange": (250, 140, 20),
+    "pink": (250, 120, 190), "cyan": (40, 220, 230), "white": (245, 245, 245),
+    "brown": (130, 80, 40),
+}
+GRID, PATCH, N_OBJ = 12, 14, 4
+
+
+def draw(objects, rng):
+    img = rng.normal(90, 10, size=(GRID * PATCH, GRID * PATCH, 3))
+    for obj in objects:
+        for (r, c), color in ((obj["pos"], obj["key"]),
+                              ((obj["pos"][0], obj["pos"][1] + 1), obj["right"]),
+                              ((obj["pos"][0] + 1, obj["pos"][1]), obj["below"])):
+            img[r * PATCH:(r + 1) * PATCH, c * PATCH:(c + 1) * PATCH] = PALETTE[color]
+    return Image.fromarray(np.clip(img, 0, 255).astype(np.uint8))
+
+
+def sample_scene(rng):
+    colors = list(PALETTE)
+    rng.shuffle(colors)
+    keys, attrs = colors[:N_OBJ], colors[N_OBJ:]
+    taken, objects = set(), []
+    for key in keys:
+        while True:
+            r, c = rng.randrange(GRID - 1), rng.randrange(GRID - 1)
+            cells = {(r, c), (r, c + 1), (r + 1, c)}
+            halo = {(a + dr, b + dc) for a, b in cells for dr in (-1, 0, 1) for dc in (-1, 0, 1)}
+            if not halo & taken:
+                taken |= cells
+                break
+        objects.append({"key": key, "pos": (r, c),
+                        "right": rng.choice(attrs), "below": rng.choice(attrs)})
+    return objects
+
+
+def qa(obj, relation):
+    if relation == "right":
+        return (f"What color is to the right of the {obj['key']} block?",
+                f"The color to the right of the {obj['key']} block is {obj['right']}.",
+                obj["right"])
+    return (f"What color is below the {obj['key']} block?",
+            f"The color below the {obj['key']} block is {obj['below']}.",
+            obj["below"])
+
+
+def describe(objects):
+    ordered = sorted(objects, key=lambda o: o["pos"])
+    parts = [f"the {o['key']} block has {o['right']} to its right and {o['below']} below it"
+             for o in ordered]
+    return "Describe the image in detail.", "There are four blocks: " + "; ".join(parts) + ".", None
+
+
+def conversation(objects, rng, allow_describe):
+    other = {"right": "below", "below": "right"}
+    order = list(range(len(objects)))
+    rng.shuffle(order)
+    turns, asked = [], []
+    if allow_describe and rng.random() < 0.15:
+        turns.append(describe(objects))
+    k1, rel1 = order[0], rng.choice(["right", "below"])
+    turns.append(qa(objects[k1], rel1))
+    asked.append((k1, rel1))
+    if rng.random() < 0.5:                                  # T2 follow-up
+        turns.append(qa(objects[k1], other[rel1]))
+        asked.append((k1, other[rel1]))
+        nxt = 1
+    else:                                                   # T2 new object
+        rel = rng.choice(["right", "below"])
+        turns.append(qa(objects[order[1]], rel))
+        asked.append((order[1], rel))
+        nxt = 2
+    if rng.random() < 0.5:                                  # T3 new object
+        turns.append(qa(objects[order[nxt]], rng.choice(["right", "below"])))
+    else:                                                   # T3 revisit
+        k, _ = rng.choice(asked)
+        turns.append(qa(objects[k], rng.choice(["right", "below"])))
+    return turns
+
+
+def build(out_dir, n, seed, allow_describe):
+    rng = random.Random(seed)
+    nrng = np.random.default_rng(seed)
+    os.makedirs(os.path.join(out_dir, "images"), exist_ok=True)
+    items = []
+    for index in range(n):
+        objects = sample_scene(rng)
+        name = f"blk_{seed}_{index:06d}.png"
+        draw(objects, nrng).save(os.path.join(out_dir, "images", name))
+        turns = conversation(objects, rng, allow_describe)
+        items.append({
+            "image": name,
+            "turns": [{"question": q, "answer": a, "target": t} for q, a, t in turns],
+            "objects": objects,
+        })
+    return items
+
+
+if __name__ == "__main__":
+    out = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(os.path.abspath(__file__)), "work", "data")
+    # Training data is generated on the fly by train_toy.py; only the test
+    # set (fixed seed 2, no DESCRIBE turns) is written to disk.
+    test = build(out, int(sys.argv[2]) if len(sys.argv) > 2 else 300, 2, False)
+    json.dump(test, open(os.path.join(out, "test.json"), "w"))
+    print("test conversations:", len(test))
