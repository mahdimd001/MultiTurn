@@ -0,0 +1,110 @@
+#!/bin/bash
+
+#SBATCH --time=48:00:00
+#SBATCH --nodes=1
+#SBATCH --ntasks-per-node=1
+#SBATCH --mem=100G
+#SBATCH --gres=gpu:a100:1
+#SBATCH --partition=nova
+#SBATCH --job-name="turncast-kv"
+#SBATCH --error="%j-error"
+#SBATCH --output="%j-turncast.out"
+
+# TurnCast-KV on LLaVA-1.5-7B: collect -> train -> offline check -> end-to-end vs PyramidKV.
+#
+#   sbatch run-job-turncast                                  # everything, ratios 0.9 0.8 0.5
+#   sbatch --export=ALL,STAGE=prepare run-job-turncast       # collect + train + offline check (~30 min)
+#   sbatch --export=ALL,STAGE=eval,RATIOS=0.9 run-job-turncast   # one ratio per job, in parallel
+#
+# Training uses 200 conversations of each dataset; every end-to-end run below is
+# on the HELD-OUT conversations (turncast_data/<dataset>/heldout.json), with
+# PyramidKV re-run on exactly the same conversations, so compare_rouge_runs.py
+# pairs every turn.
+
+source /lustre/hdd/LAS/jannesar-lab/tmahmud/ecache/bin/activate
+
+STAGE=${STAGE:-all}
+RATIOS=${RATIOS:-"0.9 0.8 0.5"}
+MODEL=/lustre/hdd/LAS/jannesar-lab/tmahmud/models/llava-v1.5-7b
+ROOT=/lustre/hdd/LAS/jannesar-lab/msamani/modality_aware_KVCache
+CONV_DATA=$ROOT/ConvBench/convbench.json
+CONV_IMG=$ROOT/ConvBench/visit_bench_images
+MV_DATA=$ROOT/MultiVerse_for_ppl/multiverse_ppl_full.json
+MV_IMG=$ROOT/MultiVerse_raw/images
+DATA_DIR=turncast_data
+SCORER=$DATA_DIR/turncast_scorer.pt
+
+collect () {  # collect <dataset> <data> <images> [extra]
+  python turncast/collect.py --model-path $MODEL --data-path $2 --image-path $3 \
+      --dataset $1 --out-dir $DATA_DIR --train-count 200 --seed 0 "${@:4}"
+}
+
+if [ "$STAGE" = all ] || [ "$STAGE" = prepare ]; then
+  # 1) Training data: 200 conversations per dataset, one teacher-forced pass each.
+  collect convbench  $CONV_DATA $CONV_IMG
+  collect multiverse $MV_DATA   $MV_IMG
+  # Held-out conversations for the offline check only (the end-to-end runs use all of them).
+  collect convbench  $CONV_DATA $CONV_IMG --split heldout --limit 60
+  collect multiverse $MV_DATA   $MV_IMG   --split heldout --limit 60
+
+  # 2) Train the forecaster; 3) offline check against PyramidKV on held-out data.
+  python turncast/train.py \
+      --train-dirs $DATA_DIR/convbench/train $DATA_DIR/multiverse/train \
+      --eval-dirs  $DATA_DIR/convbench/heldout $DATA_DIR/multiverse/heldout \
+      --out $SCORER | tee $DATA_DIR/train_log.txt
+fi
+
+[ "$STAGE" = prepare ] && exit 0
+[ -f $SCORER ] || { echo "missing $SCORER: run STAGE=prepare first"; exit 1; }
+
+# 4) End-to-end ROUGE on held-out conversations.
+run () {  # run <tag> <data> <images> <method> <ratio> [extra args...]
+  local TAG=$1 DATA=$2 IMG=$3 METHOD=$4 RATIO=$5; shift 5
+  python eval_rouge_final2.py --model-path $MODEL --data-path $DATA --image-path $IMG \
+      --method $METHOD --ratio $RATIO --output-dir logs_rouge_llava/turncast/${TAG}-${RATIO} "$@"
+}
+compare () {  # compare <tag> <ratio> <baseline file stem> <new file stem>
+  local DIR=logs_rouge_llava/turncast/${1}-${2}
+  python compare_rouge_runs.py $DIR/${3}_predictions.json $DIR/${4}_predictions.json \
+      | tee $DIR/${4}_vs_${3}.txt
+}
+
+for RATIO in $RATIOS; do
+  for DS in convbench multiverse; do
+    if [ $DS = convbench ]; then IMG=$CONV_IMG; else IMG=$MV_IMG; fi
+    HELD=$DATA_DIR/$DS/heldout.json
+    run $DS $HELD $IMG pyramidkv   $RATIO                                 # the logged baseline
+    run $DS $HELD $IMG pyramidkv   $RATIO --pyramid-exact-budget          # same memory as TurnCast
+    run $DS $HELD $IMG turncast_kv $RATIO --turncast-scorer $SCORER
+    compare $DS $RATIO pyramidkv_ratio${RATIO}       turncast_kv_ratio${RATIO}
+    compare $DS $RATIO pyramidkv_ratio${RATIO}_exact turncast_kv_ratio${RATIO}
+    # ablation: the forecaster at turn boundaries too (default: PyramidKV's window rule there)
+    run $DS $HELD $IMG turncast_kv $RATIO --turncast-scorer $SCORER --turncast-boundary forecast
+    compare $DS $RATIO pyramidkv_ratio${RATIO}_exact turncast_kv_ratio${RATIO}_boundary-forecast
+    compare $DS $RATIO turncast_kv_ratio${RATIO} turncast_kv_ratio${RATIO}_boundary-forecast
+  done
+done
+
+# 5) Perplexity of the reference answers (the protocol the forecaster was trained on).
+for RATIO in $RATIOS; do
+  for DS in convbench multiverse; do
+    if [ $DS = convbench ]; then IMG=$CONV_IMG; else IMG=$MV_IMG; fi
+    HELD=$DATA_DIR/$DS/heldout.json
+    for SPEC in "pyramidkv" "pyramidkv --pyramid-exact-budget" "turncast_kv --turncast-scorer $SCORER" \
+                "turncast_kv --turncast-scorer $SCORER --turncast-boundary forecast"; do
+      set -- $SPEC
+      NAME=$1; [ "$2" = --pyramid-exact-budget ] && NAME=pyramidkv_exact
+      [ "$4" = --turncast-boundary ] && NAME=turncast_kv_boundary-forecast
+      python eval_ppl_final.py --model-path $MODEL --data-path $HELD --image-path $IMG \
+          --method "$@" --ratio $RATIO --output-dir logs_ppl_llava/turncast \
+          --eval-samples 100000 --exp-name ${DS}-${NAME}-${RATIO}
+    done
+  done
+done
+
+# 6) Overhead: same efficiency benchmark as the other methods.
+if [ "$STAGE" = all ]; then
+  python eval_efficiency.py --model-path $MODEL --data-path $CONV_DATA --image-path $CONV_IMG \
+      --methods pyramidkv turncast_kv --turncast-scorer $SCORER --ratios 0.9 \
+      --context-lengths native --num-samples 20 --output-dir logs_efficiency/turncast
+fi
