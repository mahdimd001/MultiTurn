@@ -179,6 +187,17 @@ class PyramidKVCache:
         if max_num >= q_len - window:
             max_num = q_len - window
             min_num = past_average * 2 - max_num
+        if self.exact_budget:
+            # Same linear pyramid with an exact float slope; largest-remainder
+            # rounding makes the integer budgets sum to L * past_average.
+            slope = (max_num - min_num) / (self.layer_num - 1)
+            exact = [max_num - layer_idx * slope for layer_idx in range(self.layer_num)]
+            caps = [int(x) for x in exact]
+            missing = past_average * self.layer_num - sum(caps)
+            order = sorted(range(self.layer_num), key=lambda i: exact[i] - caps[i], reverse=True)
+            for layer_idx in order[:max(0, missing)]:
+                caps[layer_idx] += 1
+            return caps
         steps = (max_num - min_num) // (self.layer_num - 1)
         return [max_num - layer_idx * steps for layer_idx in range(self.layer_num)]
 
