@@ -81,6 +82,13 @@ class PyramidKVCache:
         self.kernel_size = int(kernel_size)
         self.pooling = str(pooling)
         self.beta = float(beta)
+        # The KVCache-Factory schedule floors its per-layer step, so the
+        # realized average exceeds C by up to (L - 1) / 2 entries per layer
+        # (about +10-17% at ratio 0.9 for LLaVA-1.5-7B).  exact_budget keeps
+        # the same linear pyramid but makes the total exactly L * C, which is
+        # the budget every other method in this repo uses.  Default False
+        # reproduces the original schedule.
+        self.exact_budget = bool(exact_budget)
 
