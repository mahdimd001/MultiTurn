+"""
+RehearsalKV: anticipatory KV-cache eviction for multi-turn VLM conversations.
+
+Idea
+----
+Every eviction method in this repo decides what to keep by looking BACKWARD:
+attention that already happened (H2O / MEDA / turn-conditioned), the last few
+tokens of the prompt or of the answer (PyramidKV / SnapKV), or text-to-image
+attention of the current question (TGV-KV).  In a conversation, however, the
+cache is compressed for a question that has NOT been asked yet.  Whatever is
+evicted at Turn 1 is gone for Turns 2, 3, 4.
+
+RehearsalKV decides by looking FORWARD.  Right before each compression the
+model REHEARSES the next user turn: a short synthetic user message is placed
+at exactly the logical position where the real next turn will start, it is
+run through the model once (teacher-forced, no generation), and its queries
+show which cached entries the next turn is likely to read.  Those entries are
+kept, everything else is evicted, and the rehearsal's own KV is thrown away.
+
+The rehearsal is built from four dialogue acts, which are the things a follow-up
+question can do:
+
+    REVISIT  re-ask every user question so far (Q1 ... Qt)
+             -> follow-ups and clarifications on ANY earlier topic, not only Q1
+    RECALL   "Summarize our conversation so far."  (omitted before Turn-1 answer)
+             -> references to what the assistant already said
+    EXPLORE  "Describe the image in detail."
+             -> questions about image content nobody has asked about yet
+    RESPOND  the closing " ASSISTANT:" template tokens
+             -> the state from which the next answer will be generated
+
+Each act gets equal weight (its tokens are averaged, then acts are averaged),
+so a long question cannot drown out the others.  As the conversation grows,
+REVISIT holds more questions, so the generic EXPLORE prior automatically gets
+a smaller share (1 / number_of_acts).
+
+Two details matter in this repo's protocol:
+
+* At the Turn-1 prefill the prompt is "USER: Q1\\n<image> ASSISTANT:".  Q1
+  comes BEFORE the image, so under causal attention Q1's tokens never see the
+  image, and PyramidKV's 8-token window is 3 image tokens + " ASSISTANT:".
+  The rehearsal replays Q1 AFTER the image, so the question can actually look
+  at the image when the Turn-1 compression (which decides the visual tokens for
+  the whole conversation) is made.
+* The rehearsal sits at the future logical position, so its RoPE distances to
+  the cached entries are the ones the real next turn will have.
+
+Budget
+------
+Same as every other method here: an average of C = int(logical_len * (1 - ratio))
+entries per layer at each compression point.  Compression happens at the same
+two points as PyramidKV and MEDA: right after the Turn-1 multimodal prefill and
+at every turn boundary (``finalize_turn``).  Inside a turn tokens are appended.
+
+Layer allocation is read off the rehearsal as well: each layer's evictable
+budget is proportional to the rehearsal attention mass that falls on evictable
+entries in that layer ("demand").  Proportional allocation maximizes
+sum_l demand_l * log(budget_l), i.e. diminishing returns per layer; no pyramid
+slope or calibration profile is needed.
+
+Selection is per KV head (each head keeps its own positions, same count per
+layer), with the attention-sink prefix (``start_size``) and the ``recent_size``
+newest entries always kept.
+
+Hyperparameters
+---------------
+Only ``ratio`` (shared with all methods).  ``start_size`` = 1 and
+``recent_size`` = 8 are the repo's / SnapKV's standard protected sizes and are
+not tuned.  The two generic sentences are fixed.  No pooling kernel, no window
+size, no pyramid beta, no score weights, no sensitivity calibration.
+
+Cost
+----
+One extra forward pass of a few dozen tokens per compression (the prefill and
+each turn boundary).  In exchange, no attention maps are needed during the
+prefill or during decoding, so the evaluator runs those passes with
+``output_attentions=False``.
+
+Related work
+------------
+Rehearsal-style scoring exists for text: KVzip (rereads the whole context),
+Attic-KV (generates self-quiz question-answer pairs, arXiv 2610.12133),
+EpiCache (replays medoid history segments per episode), LAQ (generates pseudo
+answers) and DapQ (positional placeholders).  RehearsalKV differs in what it
+rehearses (the next user turn of a conversation, built from dialogue acts and
+the conversation's own questions), in needing no generation (one teacher-forced
+pass of tens of tokens), in being repeated at every turn of a multimodal
+conversation, and in reading layer budgets off the same pass.
+``aggregation="max"`` gives the KVzip / Attic-KV style peak aggregation as an
+ablation of the default act-weighted mean.
+
+Interface (used by eval_rouge_final2.py / eval_ppl_final.py)
+-----------------------------------------------------------
+    cache = RehearsalKVCache(layer_num=..., ratio=..., tokenizer=tokenizer)
+    cache.attach_model(model)            # evaluator already does this
+    cache.register_question(q_text)      # once per turn, before its tokens
+    past = cache(past, num_of_token, attentions=None)  # after every forward
+    past = cache.finalize_turn(past)     # at every turn boundary
+"""
+
+import torch
+
+from tgv_kv_legacy_nova import online_attention, set_legacy_logical_position_limit
+
+
+EXPLORE_TEXT = "Describe the image in detail."
+RECALL_TEXT = "Summarize our conversation so far."
+ALL_ACTS = ("revisit", "recall", "explore", "respond")
+
+
+class RehearsalKVCache:
+    """Anticipatory multi-turn eviction: keep what a rehearsed next turn reads."""
+
+    def __init__(
+        self,
+        layer_num,
+        ratio=0.0,
+        start_size=1,
+        recent_size=8,
+        k_seq_dim=2,
+        v_seq_dim=2,
+        tokenizer=None,
+        user_role="USER",
+        assistant_role="ASSISTANT",
+        acts=ALL_ACTS,
+        allocation="demand",
+        aggregation="mean",
+    ):
+        self.layer_num = int(layer_num)
+        self.ratio = float(ratio)
+        self.start_size = int(start_size)
+        self.recent_size = int(recent_size)
+        self.k_seq_dim = int(k_seq_dim)
+        self.v_seq_dim = int(v_seq_dim)
+        self.tokenizer = tokenizer
+        self.user_role = str(user_role)
+        self.assistant_role = str(assistant_role)
+        self.acts = tuple(acts)
+        self.allocation = str(allocation)
+        # "mean": act-weighted expected attention (the designed default).
+        # "max": peak attention over rehearsal tokens and grouped query heads,
+        # the aggregation used by KVzip / Attic-KV (ablation).
+        self.aggregation = str(aggregation)
+        if self.aggregation not in {"mean", "max"}:
+            raise ValueError("aggregation must be 'mean' or 'max'")
+
+        if self.k_seq_dim != 2 or self.v_seq_dim != 2:
+            raise ValueError("RehearsalKVCache expects KV layout [batch, heads, seq, dim]")
+        if not 0.0 <= self.ratio < 1.0:
+            raise ValueError("ratio must satisfy 0 <= ratio < 1")
+        if self.start_size < 0 or self.recent_size < 1:
+            raise ValueError("start_size must be >= 0 and recent_size >= 1")
+        unknown = set(self.acts) - set(ALL_ACTS)
+        if unknown or not self.acts:
+            raise ValueError(f"acts must be a non-empty subset of {ALL_ACTS}")
+        if self.allocation not in {"demand", "uniform"}:
+            raise ValueError("allocation must be 'demand' or 'uniform'")
+
+        self.model = None
+        self.reset()
+
+    # ------------------------------------------------------------------
+    # State
+    # ------------------------------------------------------------------
+    def reset(self):
+        """Reset all state at the beginning of a NEW dataset conversation."""
+        self.questions = []          # raw text of every user question so far
+        self.latest_logical_len = None
+        self.turn_index = 0
+        self._prefilled = False
+        self._scores = None          # per layer: [kv_heads, length] rehearsal scores
+        self._demand = None          # per layer: scalar, rehearsal mass on evictable keys
+        self._weights = None         # [probe_len] per-token act weights
+        self._kv_lengths = None
+        self.last_layer_budgets = None
+        self.last_finalize_stats = None
+
+    def attach_model(self, model):
+        """The rehearsal needs the model to run one teacher-forced pass."""
+        self.model = model
+
+    def attach_tokenizer(self, tokenizer):
+        self.tokenizer = tokenizer
+
+    def register_question(self, question):
+        """Record the raw user question of the turn that is starting."""
+        text = (question or "").replace("<image>", " ").strip()
+        if text:
+            self.questions.append(" ".join(text.split()))
+
+    # ------------------------------------------------------------------
+    # Rehearsal construction
+    # ------------------------------------------------------------------
+    def _encode(self, text):
+        return list(self.tokenizer(text, add_special_tokens=False).input_ids)
+
+    def _build_rehearsal(self, stage, device):
+        """Token ids of the synthetic next user turn and per-token act weights.
+
+        Layout (LLaVA v1 roles), one user message with one line per act:
+
+            [</s>] USER: <Q1>\\n<Q2>\\n ... <Qt>\\n<RECALL>\\n<EXPLORE> ASSISTANT:
+
+        "</s>" closes the still-open assistant turn at the Turn-1 prefill; at a
+        turn boundary the separator is already in the cache.
+        """
+        if self.tokenizer is None:
+            raise RuntimeError("RehearsalKVCache needs a tokenizer (pass tokenizer=...).")
+
+        ids, act_of_token = [], []
+
+        def add(token_ids, act):
+            ids.extend(token_ids)
+            act_of_token.extend([act] * len(token_ids))
+
+        if stage == "prefill":
+            eos = self.tokenizer.eos_token_id
+            if eos is not None:
+                add([int(eos)], None)
+        add(self._encode(f"{self.user_role}:"), None)
+
+        if "revisit" in self.acts:
+            for index, question in enumerate(self.questions):
+                add(self._encode(" " + question + "\n"), f"revisit{index}")
+        if "recall" in self.acts and stage != "prefill":
+            add(self._encode(" " + RECALL_TEXT + "\n"), "recall")
+        if "explore" in self.acts:
+            add(self._encode(" " + EXPLORE_TEXT), "explore")
+        respond_ids = self._encode(f" {self.assistant_role}:")
+        add(respond_ids, "respond" if "respond" in self.acts else None)
+
+        # Every act gets total weight 1 / (number of acts), shared by its tokens.
+        counts = {}
+        for act in act_of_token:
+            if act is not None:
+                counts[act] = counts.get(act, 0) + 1
+        if not counts:
+            raise RuntimeError("The rehearsal has no scored tokens.")
+        weights = [
+            0.0 if act is None else 1.0 / (len(counts) * counts[act])
+            for act in act_of_token
+        ]
+        probe = torch.tensor([ids], dtype=torch.long, device=device)
+        weights = torch.tensor(weights, dtype=torch.float32, device=device)
+        return probe, weights, sorted(counts)
+
+    # ------------------------------------------------------------------
+    # Rehearsal attention -> per-head scores (one layer at a time)
+    # ------------------------------------------------------------------
+    def _protected_bounds(self, length):
+        start = min(self.start_size, length)
+        end = max(start, length - self.recent_size)
+        return start, end
+
+    def _rehearsal_sink(self, layer_idx, attention):
+        """Reduce one layer's rehearsal attention to per-KV-head key scores."""
+        if attention.dim() != 4 or attention.shape[0] != 1:
+            raise RuntimeError(
+                f"Expected [1, heads, queries, keys], got {tuple(attention.shape)}"
+            )
+        length = self._kv_lengths[layer_idx]
+        probe_len = attention.shape[-2]
+        if attention.shape[-1] != length + probe_len:
+            raise RuntimeError(
+                f"Rehearsal layer {layer_idx}: attention covers {attention.shape[-1]} "
+                f"keys, expected {length} cached + {probe_len} rehearsal keys."
+            )
+        # Attention mass from each rehearsal token to each CACHED entry
+        # (rehearsal-to-rehearsal attention is not about the cache).
+        to_cache = attention[0, :, :, :length].float()                 # [H, P, S]
+        expected = torch.einsum("hps,p->hs", to_cache, self._weights)  # [H, S]
+        kv_heads = self._kv_heads[layer_idx]
+        if expected.shape[0] != kv_heads:
+            # GQA: average the query heads that share a KV head.
+            expected = expected.view(kv_heads, -1, length).mean(dim=1)
+        start, end = self._protected_bounds(length)
+        # Demand (layer budget) is always the expected rehearsal mass.
+        self._demand[layer_idx] = expected[:, start:end].sum(dim=-1).mean()
+        if self.aggregation == "max":
+            scored = to_cache[:, self._weights > 0, :].amax(dim=1)     # [H, S]
+            if scored.shape[0] != kv_heads:
+                scored = scored.view(kv_heads, -1, length).amax(dim=1)
+            self._scores[layer_idx] = scored
+        else:
+            self._scores[layer_idx] = expected
+
+    def _rehearse(self, past_key_values, stage):
+        if self.model is None:
+            raise RuntimeError("RehearsalKVCache needs attach_model(model) before use.")
+        device = past_key_values[0][0].device
+        probe, self._weights, acts = self._build_rehearsal(stage, device)
+        probe_len = probe.shape[1]
+
+        self._kv_lengths = [k.size(self.k_seq_dim) for k, _ in past_key_values]
+        self._kv_heads = [k.size(1) for k, _ in past_key_values]
+        self._scores = [None] * self.layer_num
+        self._demand = [None] * self.layer_num
+
+        # The rehearsal occupies the logical positions the next turn will use.
+        position_ids = torch.arange(
+            self.latest_logical_len,
+            self.latest_logical_len + probe_len,
+            dtype=torch.long,
+            device=device,
+        ).unsqueeze(0)
+        set_legacy_logical_position_limit(self.model, self.latest_logical_len + probe_len)
+
+        # Only attention is needed, so run the decoder stack without the LM head.
+        decoder = self.model.get_model() if hasattr(self.model, "get_model") else self.model.model
+        with torch.no_grad(), online_attention(self.model, self._rehearsal_sink):
+            # use_cache=False: the rehearsal's own K/V are never stored, so the
+            # real cache is left exactly as it was.
+            decoder(
+                input_ids=probe,
+                position_ids=position_ids,
+                past_key_values=past_key_values,
+                use_cache=False,
+                output_attentions=True,
+            )
+
+        missing = [i for i, s in enumerate(self._scores) if s is None]
+        if missing:
+            raise RuntimeError(f"Rehearsal produced no attention for layers {missing}.")
+        return probe_len, acts
+
+    # ------------------------------------------------------------------
+    # Budgets
+    # ------------------------------------------------------------------
+    @staticmethod
+    def _bounded_largest_remainder(total, weights, upper):
+        """Integer allocation summing to ``total`` with 0 <= a_l <= upper_l."""
+        upper = upper.to(torch.long)
+        total = max(0, min(int(total), int(upper.sum())))
+        allocation = torch.zeros_like(upper)
+        remaining = total
+        weights = weights.double().clamp_min(0)
+        while remaining > 0:
+            capacity = upper - allocation
+            active = capacity > 0
+            if not active.any():
+                break
+            active_weights = weights * active
+            if active_weights.sum() <= 0:
+                active_weights = active.double()
+            quota = remaining * active_weights / active_weights.sum()
+            add = torch.minimum(torch.floor(quota).long(), capacity)
+            if add.sum() == 0:
+                order = torch.argsort(quota - torch.floor(quota), descending=True)
+                for idx in order.tolist():
+                    if remaining == 0:
+                        break
+                    if capacity[idx] > 0:
+                        add[idx] += 1
+                        remaining -= 1
+                allocation += add
+                continue
+            allocation += add
+            remaining -= int(add.sum())
+        return allocation
+
+    def _layer_budgets(self):
+        """Evictable-entry budget per layer (protected entries come on top)."""
+        lengths = torch.tensor(self._kv_lengths, dtype=torch.long)
+        protected = torch.tensor(
+            [min(n, self.start_size + self.recent_size) for n in self._kv_lengths],
+            dtype=torch.long,
+        )
+        candidates = lengths - protected
+        target = max(1, int(self.latest_logical_len * (1.0 - self.ratio)))
+        evictable_total = max(0, target * self.layer_num - int(protected.sum()))
+        if self.allocation == "uniform":
+            demand = torch.ones(self.layer_num, dtype=torch.float64)
+        else:
+            demand = torch.stack(self._demand).double().cpu()
+            if not torch.isfinite(demand).all() or demand.sum() <= 0:
+                demand = torch.ones(self.layer_num, dtype=torch.float64)
+        keep = self._bounded_largest_remainder(evictable_total, demand, candidates)
+        return keep, target, demand
+
+    # ------------------------------------------------------------------
+    # Compression
+    # ------------------------------------------------------------------
+    def _compress(self, past_key_values, stage):
+        lengths = [k.size(self.k_seq_dim) for k, _ in past_key_values]
+        target = max(1, int(self.latest_logical_len * (1.0 - self.ratio)))
+        if sum(lengths) <= target * self.layer_num:
+            self.last_finalize_stats = {
+                "stage": stage, "turn": self.turn_index + 1,
+                "logical_len": int(self.latest_logical_len),
+                "target_per_layer": int(target), "regime": "keep_all",
+                "kv_before_layer0": int(lengths[0]),
+            }
+            return past_key_values
+
+        probe_len, acts = self._rehearse(past_key_values, stage)
+        keep, target, demand = self._layer_budgets()
+
+        new_past, kept = [], []
+        for layer_idx, (k, v) in enumerate(past_key_values):
+            length = lengths[layer_idx]
+            n_keep = int(keep[layer_idx])
+            start, end = self._protected_bounds(length)
+            if n_keep >= end - start:
+                new_past.append([k, v])
+                kept.append(length)
+                continue
+
+            kv_heads = k.shape[1]
+            scores = self._scores[layer_idx][:, start:end]               # [H, cand]
+            if n_keep > 0:
+                top = scores.topk(n_keep, dim=-1).indices.sort(dim=-1).values + start
+            else:
+                top = torch.empty(kv_heads, 0, dtype=torch.long, device=scores.device)
+            prefix = torch.arange(start, device=top.device).expand(kv_heads, -1)
+            recent = torch.arange(end, length, device=top.device).expand(kv_heads, -1)
+            index = torch.cat([prefix, top, recent], dim=-1).to(k.device)  # [H, keep]
+            index = index[None, :, :, None]
+            k_new = k.gather(self.k_seq_dim, index.expand(k.shape[0], -1, -1, k.shape[-1]))
+            v_new = v.gather(self.v_seq_dim, index.expand(v.shape[0], -1, -1, v.shape[-1]))
+            new_past.append([k_new, v_new])
+            kept.append(k_new.size(self.k_seq_dim))
+
+        self.last_layer_budgets = kept
+        self.last_finalize_stats = {
+            "stage": stage,
+            "turn": self.turn_index + 1,
+            "logical_len": int(self.latest_logical_len),
+            "target_per_layer": int(target),
+            "rehearsal_tokens": int(probe_len),
+            "rehearsal_acts": acts,
+            "kv_before_layer0": int(lengths[0]),
+            "kv_after_first": int(kept[0]),
+            "kv_after_last": int(kept[-1]),
+            "kv_after_mean": float(sum(kept) / len(kept)),
+            "layer_budgets": kept,
+            "layer_demand": [round(float(x), 4) for x in demand.tolist()],
+        }
+        # Free the rehearsal statistics; nothing is carried to the next turn.
+        self._scores = self._demand = self._weights = None
+        return new_past
+
+    # ------------------------------------------------------------------
+    # Evaluator interface
+    # ------------------------------------------------------------------
+    def __call__(self, past_key_values, num_of_token=None, attentions=None):
+        if past_key_values is None:
+            return None
+        if num_of_token is None:
+            raise ValueError("RehearsalKVCache requires num_of_token for ratio-based pruning.")
+        self.latest_logical_len = int(num_of_token)
+
+        # The first call follows the Turn-1 multimodal prefill: compress now so
+        # the Turn-1 answer is generated under the budget.
+        if not self._prefilled:
+            self._prefilled = True
+            return self._compress(past_key_values, stage="prefill")
+
+        # Within a turn: append only.
+        return past_key_values
+
+    def finalize_turn(self, past_key_values):
+        """Rehearse the next turn and compress at the turn boundary."""
+        if past_key_values is None or not self._prefilled:
+            return past_key_values
+        result = self._compress(past_key_values, stage="turn_boundary")
+        self.turn_index += 1
+        return result
