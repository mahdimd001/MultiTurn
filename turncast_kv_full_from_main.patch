@@ -0,0 +1,29 @@
+#!/bin/bash
+# Evaluate every method on MT-Blocks through eval_rouge_final2.py (via run_eval.py).
+# Usage: bash run_all.sh <out_dir> <n_samples> "<ratios>" "<method specs>"
+# A method spec is  name[:extra args, '+' for spaces], e.g.
+#   pyramidkv  pyramidkv:--pyramid-exact-budget  rehearsal_kv:--rehearsal-acts+revisit,explore,respond
+# Activate the environment that runs the repo (transformers 4.31) before calling this.
+HERE=$(cd "$(dirname "$0")" && pwd)
+OUT=$1; N=$2; RATIOS=$3; SPECS=$4
+MODEL=${TOY_MODEL:-$HERE/work/models_needles/llava-v1.5-7b-needles}
+DATA=${TOY_DATA:-$HERE/work/needles}
+mkdir -p $OUT
+jobs_list=()
+for RATIO in $RATIOS; do
+  for SPEC in $SPECS; do
+    METHOD=${SPEC%%:*}; EXTRA=""
+    [[ "$SPEC" == *:* ]] && EXTRA=$(echo "${SPEC#*:}" | tr '+' ' ')
+    jobs_list+=("$METHOD|$RATIO|$EXTRA")
+  done
+done
+run_one () {
+  IFS='|' read -r METHOD RATIO EXTRA <<< "$1"
+  TAG=$(echo "$METHOD $EXTRA" | tr ' ' '_' | tr -d '-')
+  THREADS=1 python $HERE/run_eval.py --model-path $MODEL --data-path $DATA/test.json \
+      --image-path $DATA/images --device cpu --method $METHOD --ratio $RATIO \
+      --eval-samples $N --max-token-generated 20 --output-dir $OUT $EXTRA \
+      > $OUT/log_${TAG}_${RATIO}.txt 2>&1 && echo "done $METHOD $EXTRA $RATIO" || echo "FAILED $METHOD $EXTRA $RATIO"
+}
+export -f run_one; export OUT N MODEL DATA HERE
+printf '%s\n' "${jobs_list[@]}" | xargs -P 2 -I{} bash -c 'run_one "$@"' _ {}
