new file mode 100644
index 0000000..a6d6584
--- /dev/null
+++ b/rehearsal_toy/run_eval.py
@@ -0,0 +1,48 @@
+"""Run the repo's eval_rouge_final2.py on CPU for pipeline / toy tests.
+
+Test-only shims (the evaluator logic itself is unchanged):
+  1. Cast the loaded model to float32 (CPU has no fast bf16/fp16 kernels).
+  2. Read the layer count from the model config instead of the "7b" -> 32 rule,
+     so small test models with fewer layers build correctly sized caches.
+Usage: python run_eval.py <normal eval_rouge_final2.py arguments>
+"""
+import os
+import sys
+import types
+
+import torch
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, REPO)
+os.chdir(REPO)
+torch.set_num_threads(int(os.environ.get("THREADS", 2)))
+
+source = open(os.path.join(REPO, "eval_rouge_final2.py")).read()
+old = 'layer_num = 32 if "7b" in model_name.lower() else 40'
+assert source.count(old) == 1
+source = source.replace(old, "layer_num = _TEST_LAYER_NUM")
+source = source.replace(
+    "    tokenizer, model, image_processor, loader_context_length = load_pretrained_model(",
+    "    tokenizer, model, image_processor, loader_context_length = _test_load(",
+)
+module = types.ModuleType("eval_rouge_final2_test")
+module.__file__ = os.path.join(REPO, "eval_rouge_final2.py")
+sys.modules["eval_rouge_final2_test"] = module
+
+
+def _test_load(*args, **kwargs):
+    from llava.model.builder import load_pretrained_model
+
+    tokenizer, model, processor, ctx = load_pretrained_model(*args, **kwargs)
+    model = model.float()
+    model.get_vision_tower().to(dtype=torch.float32)
+    model.eval()
+    module._TEST_LAYER_NUM = int(model.config.num_hidden_layers)
+    return tokenizer, model, processor, ctx
+
+
+module._test_load = _test_load
+module._TEST_LAYER_NUM = None
+sys.argv = ["eval_rouge_final2.py"] + sys.argv[1:]
+code = compile(source.replace('if __name__ == "__main__":', "if True:"), module.__file__, "exec")
+exec(code, module.__dict__)
